# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (Docker: use 'postgres' as DB_HOST)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=password
DB_DATABASE=basti
DB_SSL=false

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.1.100:8081

# API docs (Scalar at /api/docs) — set both to lock the docs behind HTTP Basic Auth
DOCS_USERNAME=admin
DOCS_PASSWORD=change-me

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Email (AWS SES) - MAIL_FROM_NAME must be a bare string (no quotes); code wraps it as "Name" <email>
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
MAIL_FROM_NAME=Basti
MAIL_FROM=noreply@basty.ly
# MAIL_REPLY_TO=support@basty.ly

# Firebase Admin (FCM Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 (object storage)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=basty-nestjs-backend
R2_PUBLIC_URL=https://assets.basty.ly
